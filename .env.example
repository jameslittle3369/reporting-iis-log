# Copy this file to .env and fill in real values.
# .env is loaded automatically by send_report_email.py (real environment
# variables, if set, always take precedence over this file; --to/--from/
# --from-name CLI flags always take precedence over both).

# Display name shown as the email sender
IIS_SENDER_NAME=James Little

# Verified SES sender address (see README.md for SES verification steps)
IIS_SENDER_EMAIL=reports@globaltel.com

# Default recipient(s) for send_report_email.py, comma-separated.
# Can still be overridden per-run with --to.
IIS_DEFAULT_TO=ops@globaltel.com

# Optional default CC, comma-separated
IIS_DEFAULT_CC=
